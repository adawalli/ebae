{
  "name": "ebae",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development NEXT_MANUAL_SIG_HANDLE=true ENABLE_DEV_POLLER=0 next dev",
    "dev:poller": "NODE_ENV=development NEXT_MANUAL_SIG_HANDLE=true ENABLE_DEV_POLLER=1 next dev",
    "build": "next build",
    "start": "NEXT_MANUAL_SIG_HANDLE=true next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.10",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
