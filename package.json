{
  "name": "ebae",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development NEXT_MANUAL_SIG_HANDLE=true ENABLE_DEV_POLLER=0 next dev",
    "dev:poller": "NODE_ENV=development NEXT_MANUAL_SIG_HANDLE=true ENABLE_DEV_POLLER=1 next dev",
    "build": "next typegen && tsc --noEmit && next build",
    "start": "NEXT_MANUAL_SIG_HANDLE=true next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "jose": "^6.2.3",
    "lucide-react": "^1.23.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.6.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/compat": "2.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "pino-pretty": "13.1.3",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
